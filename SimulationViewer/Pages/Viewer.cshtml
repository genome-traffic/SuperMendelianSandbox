@page
@model SimulationViewer.Pages.ViewerModel

<!DOCTYPE html>
<html>
<head>
    <title>SMS Simulation Viewer</title>
    <script src="https://cdn.plot.ly/plotly-2.35.0.min.js"></script>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <div class="nav-bar">
        <a href="/" class="btn btn-back">&larr; All models</a>
        <a href="@Model.ConfigPage" class="btn btn-back">Configure</a>
        <span class="nav-title">Results &mdash; @Model.DriveModelName</span>
    </div>

    <div class="controls">
        <form method="get" style="display:inline">
            <input type="hidden" name="model" value="@Model.DriveModel" />
            <label for="path">CSV Path:</label>
            <input type="text" name="path" id="path" value="@Model.CsvPath" size="60" />
            <button type="submit">Load</button>
        </form>
    </div>

    @if (Model.ErrorMessage != null)
    {
        <div class="error">@Model.ErrorMessage</div>
    }

    <div id="charts"></div>

    <script src="/js/charts.js?v=8"></script>
    <script>
        const data = @Html.Raw(Model.CsvJson);
        if (data.length > 0) {
            buildCharts(data);
        }
    </script>
</body>
</html>
